# ---- Core ----
AUTH_SECRET=                 # random 32+ chars; signs session cookies + OAuth state
DATABASE_URL=                # Neon Postgres (free, persistent) — preferred store
BLOB_READ_WRITE_TOKEN=       # Vercel Blob fallback store (auto-set when a Blob store is linked)
DEFAULT_WORKSPACE_ID=demo    # workspace for unrouted webhook traffic
CRON_SECRET=                 # protects /api/cron (Vercel Cron sends it)
# ---- AI ----
MODEL_API_KEY=               # Meta Llama API key (muse-spark primary)
META_MODEL=                  # optional override of the Meta model id
NVIDIA_API_KEY=              # NVIDIA NIM fallback
NVIDIA_MODEL=
META_IMAGE_API_URL=          # optional Meta image endpoint; default Pollinations
# ---- Meta platform (app 2295824264292456) ----
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_CONFIG_ID=              # Facebook Login for Business configuration id (optional)
META_PAGE_ACCESS_TOKEN=      # platform-default Page token (vendors can store their own)
META_PAGE_ID=
IG_USER_ID=                  # Instagram business account id linked to the Page
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=       # System User permanent token recommended
WA_CALLING_ENABLED=          # "true" once WhatsApp Business Calling API is approved
META_PIXEL_ID=
META_CAPI_TOKEN=
# ---- Voice ----
MUSE_VOICE_API_URL=          # Muse speech endpoint (STT w/ diarization + code-switch)
MUSE_VOICE_API_KEY=
SEAMLESS_API_URL=            # SeamlessM4T v2 endpoint (speech-to-speech)
HF_TOKEN=                    # Hugging Face fallback (whisper STT)
# ---- Payments ----
PAYSTACK_SECRET_KEY=         # NGN
STRIPE_SECRET_KEY=           # USD
STRIPE_WEBHOOK_SECRET=
# ---- Outreach email ----
RESEND_API_KEY=
OUTREACH_FROM=
# ---- Site builder deploy targets ----
VERCEL_TOKEN=
VERCEL_TEAM_ID=
NETLIFY_TOKEN=
GITHUB_TOKEN=
