MODEL_API_KEY=
NVIDIA_API_KEY=
# optional
META_MODEL=muse-spark-1.3
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# --- Meta messaging connect (WhatsApp Cloud API, Messenger, Instagram Messaging) ---
# Webhook callback URL: https://<your-domain>/api/webhooks/meta  (subscribe: messages)
META_APP_ID=                # Meta App Dashboard → App settings → Basic
META_APP_SECRET=            # same page; used to verify X-Hub-Signature-256
META_VERIFY_TOKEN=          # any random string you also paste into the Webhooks "Verify token" field
META_PAGE_ACCESS_TOKEN=     # Page token with pages_messaging (+ instagram_manage_messages for IG)
WHATSAPP_PHONE_NUMBER_ID=   # WhatsApp → API Setup → Phone number ID
WHATSAPP_ACCESS_TOKEN=      # System-user token with whatsapp_business_messaging
IG_USER_ID=                 # Instagram professional account ID linked to the Page
# META_GRAPH_VERSION=v21.0
# Without these, channels run in Demo mode with seeded threads.
